# 可选项、替代数据库连接与工具配置详见 docs/environment.md。
# Copy to .env.local and supply your own values. Do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
PRODUCTS_TABLE=products
# Generate locally: openssl rand -base64 32
AUTH_SECRET=
AUTH_DEV_MODE=false
# Optional Vercel Blob credential; required for cloud attachment uploads.
BLOB_READ_WRITE_TOKEN=
# Optional first administrator identity; leave unset until configured.
# AUTH_INITIAL_ADMIN=admin@example.com

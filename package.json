{
  "name": "fmkj-smart-design",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "cad:review": "node scripts/export-cad-review.mjs",
    "db:check": "node scripts/check-neon.mjs",
    "db:down": "docker compose -f docker-compose.db.yml stop",
    "db:migrate": "node scripts/run-migration.mjs",
    "db:reset": "docker compose -f docker-compose.db.yml down -v",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "db:smoke": "node scripts/db-smoke-test.mjs",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "dev": "next dev --turbopack",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "icons:build": "node scripts/generate-point-icons.mjs",
    "lint": "eslint",
    "products:audit": "node scripts/audit-product-images.mjs",
    "products:optimize": "node scripts/optimize-product-images.mjs",
    "products:prune": "node scripts/prune-unused-product-images.mjs",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "1.3.1",
    "@vercel/blob": "^2.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "input-otp": "1.4.1",
    "jose": "^6.0.0",
    "lucide-react": "^1.21.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.4",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "shadcn": "^4.12.0",
    "sharp": "0.34.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@mlightcad/libredwg-web": "0.8.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "license": "MIT",
  "description": "一个帮智能家居设计师、安装服务商和小团队做方案、出报价、管项目的开源工具。把客户项目、设备点位、产品清单和报价单放在一起管理。关键词：智能家居、全屋智能、点位图设计、产品选型、报价系统、项目管理。",
  "keywords": [
    "智能家居",
    "全屋智能",
    "点位图设计",
    "产品选型",
    "报价系统",
    "项目管理",
    "smart-home",
    "home-automation",
    "nextjs",
    "react",
    "typescript",
    "postgresql"
  ]
}
